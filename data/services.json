{
  "_comment": "Service registry. `pricingUrl` is a template: {cc} = market country code, {lang} = market language. `plans` are canonical ids; labels live in src/i18n/*.json under `plan.<id>`. `source` tells the harvester which free channel to use: 'live' = fetch the page directly, 'wayback' = read the archived snapshot index, 'both' = live now plus archived history.",
  "services": {
    "spotify": {
      "name": "Spotify",
      "category": "Music",
      "homepage": "https://www.spotify.com/",
      "pricingUrl": "https://www.spotify.com/{cc}/premium/",
      "archive": {
        "prefix": "www.spotify.com/{cc}",
        "path": "/premium",
        "exclude": []
      },
      "source": "both",
      "markets": [
        "tn",
        "eg",
        "fr",
        "sa",
        "ma",
        "de",
        "us"
      ],
      "plans": [
        {
          "id": "individual",
          "flagship": true
        },
        {
          "id": "duo"
        },
        {
          "id": "platinum"
        },
        {
          "id": "family"
        },
        {
          "id": "student"
        }
      ],
      "note": "Ships per-country pricing pages with server-rendered prices. Arabic-Indic numerals on the EG page — the extractor normalises them."
    },
    "netflix": {
      "name": "Netflix",
      "category": "Streaming",
      "homepage": "https://www.netflix.com/",
      "pricingUrl": "https://www.netflix.com/{cc}/",
      "archive": {
        "prefix": "www.netflix.com/{cc}",
        "path": "",
        "exclude": [
          "/title/",
          "/browse/",
          "/watch/",
          "/gift/"
        ]
      },
      "source": "both",
      "markets": [
        "tn",
        "eg",
        "fr",
        "sa",
        "ma",
        "tr",
        "de",
        "us"
      ],
      "plans": [
        {
          "id": "withads"
        },
        {
          "id": "standard",
          "flagship": true
        },
        {
          "id": "premium"
        }
      ],
      "note": "Netflix geo-redirects to the requester's country, so a fetch from outside the market may return the wrong market. The receipt records the final URL that answered, and prices are labelled with the currency actually shown. In TN the page quotes US dollars — a finding in itself."
    },
